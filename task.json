{
  "atomCode": "text-finder",
  "name": "Find text in log",
  "version": "1.1.0",
  "description": "Searches the build log or workspace files and can fail the build on a match or on a missing match.",
  "execution": {
    "packagePath": "text-finder.jar",
    "language": "java",
    "target": "$atom_java_path -cp text-finder.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "regexp": {
      "label": "正则（逗号分隔多个）",
      "type": "vuex-input",
      "default": ""
    },
    "useBuildLog": {
      "label": "搜索构建日志",
      "type": "checkbox",
      "default": "true"
    },
    "fileSet": {
      "label": "此外搜索这些文件（glob，逗号分隔）",
      "type": "vuex-input",
      "default": ""
    },
    "buildResult": {
      "label": "命中时把构建置为",
      "type": "selector",
      "default": "FAILURE",
      "options": [
        "FAILURE",
        "UNSTABLE",
        "SUCCESS"
      ]
    },
    "failWhenMissing": {
      "label": "没命中就让这一步失败",
      "type": "checkbox",
      "default": "false"
    }
  },
  "output": {
    "matches": {
      "type": "string",
      "description": "命中行数"
    },
    "linesScanned": {
      "type": "string",
      "description": "扫描行数"
    },
    "firstMatch": {
      "type": "string",
      "description": "第一条命中"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    },
    "context": [
      "log"
    ]
  }
}
